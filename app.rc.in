IDI_ICON1 ICON DISCARDABLE "@ICON_RESOURCE_PATH@"

1 VERSIONINFO
FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS 0x1L
#else
FILEFLAGS 0x0L
#endif
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "ShearPlate"
            VALUE "FileDescription", "ShearPlate - Clipboard History"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "ShearPlate"
            VALUE "OriginalFilename", "ShearPlate.exe"
            VALUE "ProductName", "ShearPlate"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
